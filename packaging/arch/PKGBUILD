# Maintainer: Yousef <github-viral8565@pxdmail.com>
#
# Repackages the prebuilt release tarball placed next to this file, so the
# binaries match the .deb and tarball (see .github/workflows/build.yml).
# CI also fills in pkgver and url.

pkgname=framework-kcm
pkgver=0.2.0
pkgrel=1
pkgdesc='System Settings module for Framework laptops: charge limit, fans, touchpad, LEDs and firmware info'
arch=('x86_64')
url='https://github.com/OWNER/framework-kcm'
license=('GPL-3.0-or-later')
# dbus, kirigami, polkit and qt6-declarative are only used at runtime (bus
# policy, QML modules), so namcap can't see them
depends=(
  'dbus'
  'glibc'
  'hicolor-icon-theme'
  'kcmutils'
  'kcoreaddons'
  'ki18n'
  'kirigami'
  'libgcc'
  'libstdc++'
  'polkit'
  'qt6-base'
  'qt6-declarative'
  'systemd-libs'
)
install=framework-kcm.install
# Already stripped by the build
options=('!strip' '!debug')
source=("$pkgname-$pkgver-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cp -a usr "$pkgdir"/
}
